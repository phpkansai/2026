---
import { site } from '../lib/data';
import { slot } from '../lib/slots';
import { resolveTimetableHref } from '../lib/fortee';
import XIcon from './icons/XIcon.astro';
import NoteIcon from './icons/NoteIcon.astro';

interface Props {
  subpage?: boolean;
}
const { subpage = false } = Astro.props;
const anchor = (id: string) => (subpage ? `/#${id}` : `#${id}`);

const logo = slot('logo-header');
const timetableHref = await resolveTimetableHref();
const timetableExternal = timetableHref.startsWith('http');

const navItems = [
  { label: '開催概要', href: anchor('overview') },
  { label: '行動規範', href: '/coc/' },
  { label: 'タイムテーブル', href: timetableHref, external: timetableExternal, show: site.sections.timetable },
  { label: 'スポンサー', href: anchor('sponsors'), show: site.sections.sponsors },
  { label: 'スタッフ', href: anchor('staff'), show: site.sections.staff },
  {
    label: site.cta.label,
    href: site.cta.href.startsWith('#') ? anchor(site.cta.href.slice(1)) : site.cta.href,
    external: site.cta.href.startsWith('http'),
    show: site.cta.href !== '#recruit' || site.sections.recruit,
  },
].filter((item) => item.show !== false);
---

<header class="header" id="site-header">
  <div class="header__inner">
    <a class="header__logo" href="/" aria-label={site.event.name}>
      {
        logo ? (
          <img src={logo} alt={site.event.name} width="180" height="36" />
        ) : (
          <span class="header__logo-text">
            <span class="header__logo-php">PHP</span>
            <span class="header__logo-sub">
              Conference
              <br />
              KANSAI <em>2026</em>
            </span>
          </span>
        )
      }
    </a>

    <nav class="header__nav" id="site-nav" aria-label="メインメニュー">
      <ul class="header__list">
        {
          navItems.map((item) => (
            <li>
              <a
                href={item.href}
                target={item.external ? '_blank' : undefined}
                rel={item.external ? 'noopener noreferrer' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
      <ul class="header__social">
        <li>
          <a href={site.links.x} target="_blank" rel="noopener noreferrer" aria-label="X (旧Twitter)">
            <XIcon />
          </a>
        </li>
        <li>
          <a href={site.links.note} target="_blank" rel="noopener noreferrer" aria-label="note">
            <NoteIcon />
          </a>
        </li>
      </ul>
    </nav>

    <button
      class="header__toggle"
      id="nav-toggle"
      type="button"
      aria-controls="site-nav"
      aria-expanded="false"
      aria-label="メニューを開く"
    >
      <span></span><span></span><span></span>
    </button>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 100;
    height: var(--header-h);
    /* FV（ヒーロー）の上では背景と同化して透けて見え、紫の上では文字が読める */
    background: var(--c-bg-pink);
    transition: transform 0.25s ease;
  }

  /* 下スクロールで隠れ、上スクロールで現れる */
  .header.is-hidden:not(.is-open) {
    transform: translateY(-100%);
  }

  @media (prefers-reduced-motion: reduce) {
    .header {
      transition: none;
    }
  }

  .header__inner {
    width: min(100% - 32px, var(--container));
    margin-inline: auto;
    height: 100%;
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .header__logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    margin-right: auto;
  }

  .header__logo img {
    height: 36px;
    width: auto;
  }

  .header__logo-text {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--c-text);
    line-height: 1;
  }

  .header__logo-php {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 26px;
    letter-spacing: -0.02em;
  }

  .header__logo-sub {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 10px;
    line-height: 1.1;
    letter-spacing: 0.02em;
  }

  .header__logo-sub em {
    font-style: normal;
    color: var(--c-white);
    background: var(--c-pink);
    border-radius: 3px;
    padding: 0 3px;
  }

  .header__nav {
    display: flex;
    align-items: center;
    gap: 20px;
  }

  .header__list {
    display: flex;
    align-items: center;
    gap: 22px;
  }

  .header__list a {
    display: inline-flex;
    align-items: center;
    line-height: 1;
    font-size: 16px;
    font-weight: 700;
    text-decoration: none;
    color: var(--c-text);
    transition: color 0.15s;
  }

  .header__list a:hover {
    color: var(--c-purple);
  }

  .header__social {
    display: flex;
    align-items: center;
    gap: 22px;
    margin-inline: 10px 6px;
    /* 日本語の見た目の中心は行の中心より少し下にあるため、アイコンを下げて揃える */
    position: relative;
    top: 2px;
  }

  .header__social a {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 34px;
    height: 34px;
    padding: 8px;
    border-radius: 50%;
    background: var(--c-white);
    color: var(--c-text);
    transition: color 0.15s;
  }

  .header__social a:hover {
    color: var(--c-purple);
  }

  .header__toggle {
    display: none;
    width: 40px;
    height: 40px;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 5px;
    border-radius: 8px;
  }

  .header__toggle span {
    display: block;
    width: 22px;
    height: 2px;
    background: var(--c-text);
    border-radius: 2px;
    transition: transform 0.2s, opacity 0.2s;
  }

  /* ---- スマホ ---- */
  @media (max-width: 900px) {
    .header__inner {
      gap: 10px;
    }

    .header__logo img {
      height: 26px;
    }

    .header__toggle {
      display: flex;
    }

    .header__nav {
      position: fixed;
      inset: var(--header-h) 0 auto 0;
      flex-direction: column;
      align-items: stretch;
      gap: 0;
      padding: 8px 16px 24px;
      background: var(--c-bg-pink);
      box-shadow: 0 16px 32px rgba(75, 54, 137, 0.15);
      transform: translateY(-8px);
      opacity: 0;
      visibility: hidden;
      transition: transform 0.2s ease, opacity 0.2s ease, visibility 0.2s;
    }

    .header.is-open .header__nav {
      transform: translateY(0);
      opacity: 1;
      visibility: visible;
    }

    .header__list {
      flex-direction: column;
      align-items: stretch;
      gap: 0;
    }

    .header__list a {
      display: block;
      padding: 14px 4px;
      font-size: 16px;
      border-bottom: 1px solid var(--c-line);
    }

    .header__social {
      justify-content: center;
      gap: 32px;
      margin-inline: 0;
      top: 0;
      padding-top: 20px;
    }

    .header__social a {
      width: 40px;
      height: 40px;
      padding: 10px;
    }

    .header.is-open .header__toggle span:nth-child(1) {
      transform: translateY(7px) rotate(45deg);
    }
    .header.is-open .header__toggle span:nth-child(2) {
      opacity: 0;
    }
    .header.is-open .header__toggle span:nth-child(3) {
      transform: translateY(-7px) rotate(-45deg);
    }
  }
</style>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('nav-toggle');
  const nav = document.getElementById('site-nav');

  if (header && toggle && nav) {
    const setOpen = (open: boolean) => {
      header.classList.toggle('is-open', open);
      toggle.setAttribute('aria-expanded', String(open));
      toggle.setAttribute('aria-label', open ? 'メニューを閉じる' : 'メニューを開く');
    };
    toggle.addEventListener('click', () => setOpen(!header.classList.contains('is-open')));
    nav.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') setOpen(false);
    });

    // 下スクロールで隠し、上スクロールで表示する
    const THRESHOLD = 8; // この量以上動いたときだけ判定（細かい揺れを無視）
    let lastY = window.scrollY;
    let ticking = false;
    const onScroll = () => {
      const y = window.scrollY;
      const diff = y - lastY;
      if (Math.abs(diff) >= THRESHOLD) {
        const headerH = header.offsetHeight;
        if (diff > 0 && y > headerH) {
          header.classList.add('is-hidden');
        } else if (diff < 0 || y <= headerH) {
          header.classList.remove('is-hidden');
        }
        lastY = y;
      }
      ticking = false;
    };
    window.addEventListener(
      'scroll',
      () => {
        if (!ticking) {
          ticking = true;
          requestAnimationFrame(onScroll);
        }
      },
      { passive: true },
    );
  }
</script>
