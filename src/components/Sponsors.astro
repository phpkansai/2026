---
/**
 * スポンサー一覧。fortee のスポンサーAPI（プランごと）をランクに振り分けて表示する。
 * sponsors.yaml は fortee にロゴが無いときのロゴ補完と、fortee 未登録のスポンサーの追加に使う。
 * 個人スポンサーのプラン（site.yaml の individual_sponsors.plans）はここでは表示しない（IndividualSponsors.astro）。
 */
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { site, sponsors as localSponsors } from '../lib/data';
import { sponsorLogos } from '../lib/assets';
import { fetchSponsorPlans, type ForteeSponsorPlan } from '../lib/fortee';
import { normalizeName } from '../lib/people';
import Cloud from './Cloud.astro';

interface Card {
  name: string;
  url?: string;
  /** fortee のロゴURL */
  logoUrl?: string;
  /** src/assets/sponsors のロゴ */
  logo?: ImageMetadata;
}

const norm = (s: string) => s.trim().toLowerCase();
const planNames = (plan: ForteeSponsorPlan) =>
  [plan.name, plan.name_en].filter((n): n is string => Boolean(n)).map(norm);

const individualPlans = new Set((site.individual_sponsors?.plans ?? []).map(norm));
const tierOfPlan = (plan: ForteeSponsorPlan) =>
  site.sponsor_tiers.find((t) => {
    const names = (t.plans ?? [t.id, t.label]).map(norm);
    return planNames(plan).some((n) => names.includes(n));
  });

const plans = await fetchSponsorPlans();
const localByName = new Map(localSponsors.map((s) => [normalizeName(s.name), s]));
const usedLocal = new Set<string>();
const tierItems = new Map<string, Card[]>(site.sponsor_tiers.map((t) => [t.id, []]));

// ロゴ画像が無いスポンサーは非表示（ランク内が全員ロゴ無しならランクごと非表示）
const localLogo = (file: string | undefined, name: string) => {
  const logo = file ? sponsorLogos.get(file) : undefined;
  if (!logo) console.warn(`[sponsors] ロゴ画像が見つかりません: src/assets/sponsors/${file ?? '(未設定)'} (${name})`);
  return logo;
};

// 1) fortee のスポンサー
for (const plan of plans) {
  if (planNames(plan).some((n) => individualPlans.has(n))) continue;
  const tier = tierOfPlan(plan);
  if (!tier) {
    console.warn(`[sponsors] fortee のプラン「${plan.name}」に対応するランクがありません（site.yaml の sponsor_tiers[].plans に追加してください）`);
    continue;
  }
  for (const s of plan.sponsors) {
    const key = normalizeName(s.name);
    const local = localByName.get(key);
    if (local) usedLocal.add(key);
    const logo = s.avatar ? undefined : localLogo(local?.logo, s.name);
    if (!s.avatar && !logo) continue;
    tierItems.get(tier.id)!.push({ name: s.name, url: s.url || local?.url, logoUrl: s.avatar, logo });
  }
}

// 2) sponsors.yaml にだけ書かれているスポンサー
for (const s of localSponsors) {
  if (usedLocal.has(normalizeName(s.name))) continue;
  const list = tierItems.get(s.tier);
  if (!list) {
    console.warn(`[sponsors] 未定義の tier があります: ${s.name}(${s.tier})`);
    continue;
  }
  const logo = localLogo(s.logo, s.name);
  if (!logo) continue;
  list.push({ name: s.name, url: s.url, logo });
}

// スポンサーがいないランクは見出しごと出さない
const tiers = site.sponsor_tiers
  .map((t) => ({ ...t, items: tierItems.get(t.id)! }))
  .filter((t) => t.items.length > 0);
const { sponsors: text } = site;
---

<section class="section section--purple sponsors" id="sponsors">
  <Cloud class="sponsors__cloud sponsors__cloud--1" dim />
  <Cloud class="sponsors__cloud sponsors__cloud--2" dim flip />

  <div class="container sponsors__inner">
    <div class="sponsors__head">
      <h2 class="section-title section-title--white">{text.title}</h2>
      <p class="section-lead">
        {text.description.map((line, i) => (<>{i > 0 && <br />}{line}</>))}
      </p>
    </div>

    {tiers.length === 0 && <p class="sponsors__empty">{text.empty}</p>}

    {
      tiers.map((tier) => (
        <div class={`sponsors__tier sponsors__tier--${tier.id}`} style={`--cols:${tier.columns}`}>
          <h3 class="sponsors__tier-title">{tier.label}</h3>
          <ul class="sponsors__grid">
            {tier.items.map((s) => {
              const inner = s.logoUrl ? (
                <img src={s.logoUrl} alt={s.name} loading="lazy" decoding="async" />
              ) : (
                <Image src={s.logo!} alt={s.name} widths={[400, 800]} sizes="(max-width: 600px) 90vw, 400px" />
              );
              return (
                <li class="sponsors__item">
                  {s.url ? (
                    <a href={s.url} target="_blank" rel="noopener noreferrer" title={s.name}>
                      {inner}
                    </a>
                  ) : (
                    <div>{inner}</div>
                  )}
                </li>
              );
            })}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  .sponsors__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 48px;
  }

  .sponsors__head {
    width: 100%;
  }

  .sponsors__empty {
    opacity: 0.9;
  }

  /* 雲（紫の上なので薄く） */
  .sponsors :global(.sponsors__cloud--1) {
    top: 170px;
    right: -60px;
    width: 300px;
  }
  .sponsors :global(.sponsors__cloud--2) {
    top: 560px;
    left: -70px;
    width: 260px;
  }

  .sponsors__tier {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 24px;
  }

  .sponsors__tier-title {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 18px;
    letter-spacing: 0.08em;
  }

  /* 1枚あたりの幅をランクで変える（デザイン: 400 / 300 / 225 / 170px、縦横比 5:3）
     flex-wrap にして端数の最終行も中央に寄せる。1行の枚数は --cols（site.yaml の columns）で幅を制限して決める */
  .sponsors__grid {
    --card-w: 300px;
    --gap-x: 40px;
    --gap-y: 32px;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: var(--gap-y) var(--gap-x);
    width: 100%;
    max-width: calc(var(--cols) * var(--card-w) + (var(--cols) - 1) * var(--gap-x));
  }

  .sponsors__tier--platinum .sponsors__grid {
    --card-w: 400px;
  }
  .sponsors__tier--gold .sponsors__grid {
    --card-w: 300px;
  }
  .sponsors__tier--silver .sponsors__grid {
    --card-w: 226px;
  }
  .sponsors__tier--bronze .sponsors__grid {
    --card-w: 170px;
    --gap-x: 32px;
    --gap-y: 28px;
  }

  .sponsors__item {
    /* 1行に --cols 枚まで。画面幅に収まらないときはその幅まで縮める */
    flex: 0 0 min(var(--card-w), calc((100% - (var(--cols) - 1) * var(--gap-x)) / var(--cols)));
    aspect-ratio: 5 / 3;
    background: var(--c-white);
    border-radius: 6px;
    overflow: hidden;
  }

  .sponsors__item a,
  .sponsors__item > div {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 100%;
    height: 100%;
    padding: 8%;
    transition: transform 0.15s;
  }

  .sponsors__item a:hover {
    transform: scale(1.03);
  }

  .sponsors__item img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }


  @media (max-width: 700px) {
    .sponsors__inner {
      gap: 40px;
    }
    .sponsors :global(.sponsors__cloud--1) {
      top: 120px;
      width: 180px;
    }
    .sponsors :global(.sponsors__cloud--2) {
      top: 420px;
      width: 160px;
    }
    /* スマホ: プラチナ1列 / ゴールド・シルバー2列 / ブロンズ3列 */
    .sponsors__grid {
      --gap-x: 14px;
      --gap-y: 14px;
      max-width: none;
    }
    .sponsors__item {
      flex-basis: calc((100% - var(--gap-x)) / 2);
    }
    .sponsors__tier--platinum .sponsors__item {
      flex-basis: 100%;
    }
    .sponsors__tier--bronze .sponsors__grid {
      --gap-x: 12px;
      --gap-y: 12px;
    }
    .sponsors__tier--bronze .sponsors__item {
      flex-basis: calc((100% - var(--gap-x) * 2) / 3);
    }
  }
</style>
