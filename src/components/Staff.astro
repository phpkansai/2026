---
/**
 * スタッフ一覧。fortee のスタッフAPI（グループごと）＋ staff.yaml。
 *   - staff.yaml の leaders に挙げたハンドルの人（または fortee のグループ名が役職名と同じ人）は
 *     先頭に大きく、役職バッジ付きで表示する（実行委員長・副実行委員長）。
 *   - それ以外は fortee のグループ名（コアスタッフ / 当日スタッフ …）ごとに小見出しを付けて表示する。
 */
import { site, staffConfig } from '../lib/data';
import { staffImages } from '../lib/assets';
import { fetchStaff } from '../lib/fortee';
import { twitterHandle, normalizeHandle, normalizeName, type Person } from '../lib/people';
import { dummyEnabled, dummyPeople } from '../lib/dummy';
import PeopleGrid from './PeopleGrid.astro';

const grouped = await fetchStaff();
const hidden = new Set(staffConfig.hide ?? []);
const leaderCfg = staffConfig.leaders ?? [];
const roleByHandle = new Map(leaderCfg.map((l) => [normalizeHandle(l.twitter), l.role]));
const leaderRoles = leaderCfg.map((l) => l.role);

const leaders: Person[] = [];
const groups = new Map<string, Person[]>();
const seenHandles = new Set<string>();
const seenNames = new Set<string>();

function add(p: Person, group: string) {
  const h = normalizeHandle(p.handle);
  const n = normalizeName(p.name);
  if ((h && seenHandles.has(h)) || seenNames.has(n)) return; // fortee と extra の二重登録を防ぐ
  if (h) seenHandles.add(h);
  seenNames.add(n);

  const role = (h && roleByHandle.get(h)) || (leaderRoles.includes(group) ? group : undefined);
  if (role) {
    leaders.push({ ...p, badge: role });
    return;
  }
  if (!groups.has(group)) groups.set(group, []);
  groups.get(group)!.push(p);
}

// 1) fortee（extra より先に入れる → 同じ人がいれば fortee 側を採用）
for (const [group, list] of Object.entries(grouped)) {
  for (const s of list) {
    if (hidden.has(s.name)) continue;
    add({ name: s.name, handle: twitterHandle(undefined, s.url), url: s.url, avatarUrl: s.avatar_url }, group);
  }
}

// 2) staff.yaml の extra
for (const e of staffConfig.extra ?? []) {
  const isUrl = e.image?.startsWith('http');
  const image = !isUrl && e.image ? staffImages.get(e.image) : undefined;
  if (e.image && !isUrl && !image) {
    console.warn(`[staff] 画像が見つかりません: src/assets/staff/${e.image} (${e.name})`);
  }
  add(
    {
      name: e.name,
      handle: twitterHandle(undefined, e.url),
      url: e.url,
      avatarUrl: isUrl ? e.image : undefined,
      image,
    },
    e.role ?? 'スタッフ',
  );
}

// 役職の並びは leaders の定義順
leaders.sort((a, b) => leaderRoles.indexOf(a.badge!) - leaderRoles.indexOf(b.badge!));

// 3) 開発時のダミー（いない役職・空のグループを埋める）
if (dummyEnabled) {
  for (const role of leaderRoles) {
    if (!leaders.some((l) => l.badge === role)) leaders.push(...dummyPeople(1, { badge: role }));
  }
  leaders.sort((a, b) => leaderRoles.indexOf(a.badge!) - leaderRoles.indexOf(b.badge!));
  for (const g of staffConfig.role_order ?? []) {
    if (!groups.has(g)) groups.set(g, dummyPeople(10));
  }
}

// グループの表示順: role_order → それ以外は fortee の順
const order = staffConfig.role_order ?? [];
const rank = (g: string) => {
  const i = order.indexOf(g);
  return i === -1 ? order.length : i;
};
const groupList = [...groups.entries()]
  .map(([name, members]) => ({ name, members }))
  .sort((a, b) => rank(a.name) - rank(b.name));

const isEmpty = leaders.length === 0 && groupList.length === 0;
const { staff: text } = site;
---

<section class="section section--pink staff" id="staff">
  <div class="container staff__inner">
    <div>
      <h2 class="section-title section-title--purple">{text.title}</h2>
      <p class="section-lead">
        {text.description.map((line, i) => (<>{i > 0 && <br />}{line}</>))}
      </p>
    </div>

    {isEmpty && <p class="staff__empty">{text.empty}</p>}

    {leaders.length > 0 && <PeopleGrid people={leaders} size="lg" showHandle={false} />}

    {
      groupList.map((g) => (
        <div class="staff__group">
          <h3 class="section-subtitle">{g.name}</h3>
          <PeopleGrid people={g.members} showHandle={false} />
        </div>
      ))
    }
  </div>
</section>

<style>
  .staff__inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 48px;
  }

  .staff__empty {
    color: var(--c-text-muted);
  }

  .staff__group {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 36px;
  }
</style>
