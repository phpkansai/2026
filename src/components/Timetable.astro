---
/**
 * サイト内タイムテーブル（/timetable/）。
 * データは lib/timetable.ts（fortee → timetable.yaml → 開発時はダミーで空き枠を埋める）。
 * PC では全トラックを1つのグリッドに置き、開始・終了時刻を行境界にする（同じ時刻の枠は同じ縦位置に揃う）。
 * 左端に時刻の軸を出す。スマホではトラックごとに縦に積む（グリッドは使わない）。
 */
import { site } from '../lib/data';
import { loadTimetable, groupByTrack, buildTimeGrid, fmtTime } from '../lib/timetable';
import ArrowOutwardIcon from './icons/ArrowOutwardIcon.astro';

const items = await loadTimetable();
const tracks = groupByTrack(items);
// 1行目はトラック名、2行目以降が時刻の行。1列目は時刻の軸、2列目以降がトラック
const grid = buildTimeGrid(items, 2);
// 概要モーダルの id。トラック順・開始時刻順に連番（グリッドの枠と、後ろにまとめて置く dialog の対応付けに使う）
const dialogId = (col: number, idx: number) => `tt-dialog-${col}-${idx}`;
---

{
  items.length === 0 ? (
    <div class="tt__empty">
      <p>タイムテーブルは準備中です。</p>
      <p>
        <a href={site.links.timetable_external} target="_blank" rel="noopener noreferrer" class="btn">
          forteeで見る
          <span class="tt__arrow">
            <ArrowOutwardIcon />
          </span>
        </a>
      </p>
    </div>
  ) : (
    <div class="tt" style={`--tracks: ${tracks.length}`}>
      <ol class="tt__axis" aria-hidden="true">
        {grid.axis.map((a) => (
          <li class="tt__axis-time" style={`grid-row: ${a.row}`}>
            {fmtTime(a.time)}
          </li>
        ))}
      </ol>
      {tracks.map((track, col) => (
        <section class="tt__track" style={`--col: ${col + 2}`}>
          <h2 class="tt__track-title">{track.name}</h2>
          <ol class="tt__list">
            {track.items.map((i, idx) => (
              <li
                class:list={['tt__item', `tt__item--${i.type}`, { 'tt__item--dummy': i.dummy }]}
                style={`grid-row: ${grid.rowOf(i)}`}
              >
                <p class="tt__time">
                  <time datetime={i.starts_at}>{fmtTime(i.starts_at)}</time>
                  <span aria-hidden="true">–</span>
                  <time datetime={i.ends_at}>{fmtTime(i.ends_at)}</time>
                </p>
                <h3 class="tt__title">
                  {i.abstract ? (
                    <button class="tt__title-btn" type="button" data-dialog={dialogId(col, idx)}>
                      {i.title}
                    </button>
                  ) : i.url ? (
                    <a href={i.url} target="_blank" rel="noopener noreferrer">
                      {i.title}
                    </a>
                  ) : (
                    i.title
                  )}
                </h3>
                {i.speaker && (
                  <p class="tt__speaker">
                    {i.speaker.avatar_url ? (
                      <img src={i.speaker.avatar_url} alt="" width="28" height="28" loading="lazy" />
                    ) : (
                      <span class="tt__avatar" aria-hidden="true" />
                    )}
                    <span class="tt__speaker-name">{i.speaker.name}</span>
                    {i.speaker.twitter && (
                      <a href={`https://x.com/${i.speaker.twitter}`} target="_blank" rel="noopener noreferrer">
                        @{i.speaker.twitter}
                      </a>
                    )}
                  </p>
                )}
                {i.tags && i.tags.length > 0 && (
                  <ul class="tt__tags">
                    {i.tags.map((t) => (
                      <li style={`color:${t.color_text ?? '#fff'};background:${t.color_background ?? 'var(--c-purple)'}`}>
                        {t.name}
                      </li>
                    ))}
                  </ul>
                )}
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  )
}

{
  /* 概要モーダル。グリッドの外にまとめて置き、枠内のタイトル（ボタン）から data-dialog で開く */
  tracks.map((track, col) =>
    track.items.map(
      (i, idx) =>
        i.abstract && (
          <dialog class:list={['tt__dialog', { 'tt__dialog--dummy': i.dummy }]} id={dialogId(col, idx)} aria-labelledby={`${dialogId(col, idx)}-title`}>
            <div class="tt__dialog-inner">
              <button class="tt__dialog-close" type="button" aria-label="閉じる" data-close>
                ×
              </button>
              <p class="tt__dialog-meta">
                <span class="tt__dialog-track">{track.name}</span>
                <time datetime={i.starts_at}>{fmtTime(i.starts_at)}</time>
                <span aria-hidden="true">–</span>
                <time datetime={i.ends_at}>{fmtTime(i.ends_at)}</time>
              </p>
              <h2 class="tt__dialog-title" id={`${dialogId(col, idx)}-title`}>
                {i.title}
              </h2>
              {i.speaker && (
                <div class="tt__dialog-speaker">
                  {i.speaker.avatar_url ? (
                    <img src={i.speaker.avatar_url} alt="" width="56" height="56" />
                  ) : (
                    <span class="tt__dialog-avatar" aria-hidden="true" />
                  )}
                  <div>
                    <p class="tt__dialog-speaker-name">{i.speaker.name}</p>
                    {i.speaker.twitter && (
                      <a href={`https://x.com/${i.speaker.twitter}`} target="_blank" rel="noopener noreferrer">
                        @{i.speaker.twitter}
                      </a>
                    )}
                  </div>
                </div>
              )}
              {i.tags && i.tags.length > 0 && (
                <ul class="tt__tags">
                  {i.tags.map((t) => (
                    <li style={`color:${t.color_text ?? '#fff'};background:${t.color_background ?? 'var(--c-purple)'}`}>
                      {t.name}
                    </li>
                  ))}
                </ul>
              )}
              <p class="tt__dialog-abstract">{i.abstract}</p>
              {i.url && (
                <p class="tt__dialog-link">
                  <a href={i.url} target="_blank" rel="noopener noreferrer">
                    forteeで詳細を見る
                    <span class="tt__arrow">
                      <ArrowOutwardIcon />
                    </span>
                  </a>
                </p>
              )}
            </div>
          </dialog>
        ),
    ),
  )
}

<script>
  // タイトルのクリックで対応する dialog を開く。× ボタンと背景クリックで閉じる（Esc はブラウザ標準）
  document.addEventListener('click', (e) => {
    const target = e.target as HTMLElement;
    const opener = target.closest<HTMLElement>('[data-dialog]');
    if (opener) {
      const dialog = document.getElementById(opener.dataset.dialog ?? '') as HTMLDialogElement | null;
      dialog?.showModal();
      return;
    }
    const closer = target.closest<HTMLElement>('[data-close]');
    if (closer) {
      closer.closest('dialog')?.close();
      return;
    }
    // 背景（dialog 自身）をクリックしたら閉じる。中身（.tt__dialog-inner）のクリックは無視
    if (target instanceof HTMLDialogElement) target.close();
  });
</script>

<style>
  .tt__empty {
    text-align: center;
    padding: 40px 0;
    color: var(--c-text-muted);
    display: flex;
    flex-direction: column;
    gap: 24px;
    align-items: center;
  }

  .tt__arrow {
    display: inline-flex;
    width: 20px;
    height: 20px;
  }

  /*
   * PC: 1つのグリッド。1列目が時刻の軸、2列目以降がトラック。
   * 行は開始・終了時刻の境界（lib/timetable.ts の buildTimeGrid）。各枠は inline style の grid-row で開始行〜終了行に置く。
   * section / ol は display: contents で中身を直接グリッドに参加させる。
   */
  .tt {
    display: grid;
    grid-template-columns: auto repeat(var(--tracks, 1), minmax(0, 1fr));
    column-gap: 16px;
    row-gap: 8px;
    align-items: stretch;
  }

  .tt__track,
  .tt__list,
  .tt__axis {
    display: contents;
  }

  .tt__track-title {
    grid-row: 1;
    grid-column: var(--col);
    margin-bottom: 4px;
  }

  .tt__item {
    grid-column: var(--col);
  }

  /* 時刻の軸（何かが始まる時刻だけ出す） */
  .tt__axis-time {
    grid-column: 1;
    align-self: start;
    padding-top: 14px;
    font-weight: 700;
    font-size: 12px;
    line-height: 1;
    color: var(--c-text-muted);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .tt__track-title {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 18px;
    letter-spacing: 0.04em;
    text-align: center;
    color: var(--c-white);
    background: var(--c-purple);
    border-radius: var(--radius-sm);
    padding: 10px 12px;
  }

  .tt__item {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 16px;
    border-radius: var(--radius-sm);
    background: var(--c-bg-lavender);
    border: 1px solid var(--c-line);
  }

  /* 休憩・オープニングなどの枠は控えめに */
  .tt__item--timeslot {
    background: transparent;
    border-style: dashed;
    color: var(--c-text-muted);
    padding-block: 10px;
  }

  .tt__item--timeslot .tt__title {
    font-size: 14px;
    font-weight: 700;
  }

  .tt__time {
    display: flex;
    gap: 4px;
    font-weight: 700;
    font-size: 13px;
    color: var(--c-purple-dark);
    white-space: nowrap;
  }

  .tt__title {
    font-weight: 700;
    font-size: 15px;
    line-height: 1.6;
  }

  /* タイトル（モーダルを開くボタン / fortee へのリンク）。どちらも同じ見た目にする */
  .tt__title a,
  .tt__title-btn {
    display: inline;
    padding: 0;
    border: 0;
    background: none;
    font: inherit;
    text-align: left;
    color: var(--c-text);
    text-decoration: underline;
    text-decoration-color: var(--c-pink);
    text-underline-offset: 4px; /* 下線を文字から離す（ブラウザ標準は 2px 前後なので、約 2px 下がる） */
    cursor: pointer;
  }

  .tt__title a:hover,
  .tt__title-btn:hover {
    text-decoration: none;
  }

  .tt__speaker {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 13px;
    color: var(--c-text-muted);
  }

  .tt__speaker img,
  .tt__avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--c-placeholder);
    flex-shrink: 0;
  }

  .tt__speaker a {
    color: var(--c-purple);
    font-size: 12px;
  }

  .tt__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tt__tags li {
    font-size: 11px;
    font-weight: 700;
    padding: 2px 10px;
    border-radius: 999px;
  }

  /* 概要モーダル */
  .tt__dialog {
    width: min(640px, calc(100vw - 32px));
    max-height: calc(100vh - 48px);
    padding: 0;
    border: 0;
    border-radius: var(--radius-sm, 12px);
    background: var(--c-white);
    color: var(--c-text);
    box-shadow: 0 20px 60px rgba(43, 37, 56, 0.3);
  }

  .tt__dialog::backdrop {
    background: rgba(43, 37, 56, 0.55);
  }

  .tt__dialog-inner {
    position: relative;
    padding: 32px 28px 28px;
  }

  .tt__dialog-close {
    position: absolute;
    top: 12px;
    right: 12px;
    width: 36px;
    height: 36px;
    border: 0;
    border-radius: 50%;
    background: var(--c-bg-lavender);
    color: var(--c-purple-dark);
    font-size: 22px;
    line-height: 1;
    cursor: pointer;
  }

  .tt__dialog-close:hover {
    background: var(--c-purple);
    color: var(--c-white);
  }

  .tt__dialog-meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 6px;
    padding-right: 44px;
    font-size: 13px;
    font-weight: 700;
    color: var(--c-purple-dark);
  }

  .tt__dialog-track {
    padding: 2px 10px;
    border-radius: 999px;
    background: var(--c-purple);
    color: var(--c-white);
    font-size: 12px;
    margin-right: 4px;
  }

  .tt__dialog-title {
    margin-top: 10px;
    font-size: 20px;
    font-weight: 700;
    line-height: 1.6;
  }

  .tt__dialog-speaker {
    display: flex;
    align-items: center;
    gap: 14px;
    margin-top: 18px;
    padding: 14px 16px;
    border-radius: var(--radius-sm, 12px);
    background: var(--c-bg-lavender);
  }

  .tt__dialog-speaker img,
  .tt__dialog-avatar {
    width: 56px;
    height: 56px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--c-placeholder);
    flex-shrink: 0;
  }

  .tt__dialog-speaker-name {
    font-weight: 700;
    font-size: 16px;
  }

  .tt__dialog-speaker a {
    font-size: 13px;
    color: var(--c-purple);
  }

  .tt__dialog .tt__tags {
    margin-top: 14px;
  }

  .tt__dialog-abstract {
    margin-top: 18px;
    font-size: 14px;
    line-height: 1.9;
    white-space: pre-line;
  }

  .tt__dialog-link {
    margin-top: 20px;
    font-size: 14px;
    font-weight: 700;
  }

  .tt__dialog-link a {
    display: inline-flex;
    align-items: center;
    gap: 4px;
    color: var(--c-pink-dark);
  }

  .tt__dialog--dummy .tt__dialog-abstract {
    color: #999;
  }


  /* 開発時のダミー（グレー表示） */
  .tt__item--dummy {
    background: #f1eff4;
    border-color: #ddd;
  }

  .tt__item--dummy .tt__title,
  .tt__item--dummy .tt__speaker {
    color: #999;
  }

  /* スマホ: グリッドをやめてトラックごとに縦に積む（inline の grid-row は親がグリッドでないので効かない） */
  @media (max-width: 860px) {
    .tt {
      display: flex;
      flex-direction: column;
      gap: 32px;
    }

    .tt__axis {
      display: none;
    }

    .tt__track {
      display: block;
    }

    .tt__track-title {
      margin-bottom: 12px;
    }

    .tt__list {
      display: grid;
      gap: 10px;
    }
  }
</style>

<style is:global>
  /* モーダル表示中は背景をスクロールさせない（body はこのコンポーネントの外なので is:global） */
  body:has(dialog.tt__dialog[open]) {
    overflow: hidden;
  }
</style>
