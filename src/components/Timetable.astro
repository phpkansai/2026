---
/**
 * サイト内タイムテーブル（/timetable/）。
 * データは lib/timetable.ts（fortee → timetable.yaml → 開発時はダミーで空き枠を埋める）。
 * PC では全トラックを1つのグリッドに置き、開始・終了時刻を行境界にする（同じ時刻の枠は同じ縦位置に揃う）。
 * 左端に時刻の軸を出す。スマホではトラックごとに縦に積む（グリッドは使わない）。
 */
import { site } from '../lib/data';
import { loadTimetable, groupByTrack, buildTimeGrid, fmtTime } from '../lib/timetable';
import ArrowOutwardIcon from './icons/ArrowOutwardIcon.astro';

const items = await loadTimetable();
const tracks = groupByTrack(items);
// 1行目はトラック名、2行目以降が時刻の行。1列目は時刻の軸、2列目以降がトラック
const grid = buildTimeGrid(items, 2);
---

{
  items.length === 0 ? (
    <div class="tt__empty">
      <p>タイムテーブルは準備中です。</p>
      <p>
        <a href={site.links.timetable_external} target="_blank" rel="noopener noreferrer" class="btn">
          forteeで見る
          <span class="tt__arrow">
            <ArrowOutwardIcon />
          </span>
        </a>
      </p>
    </div>
  ) : (
    <div class="tt" style={`--tracks: ${tracks.length}`}>
      <ol class="tt__axis" aria-hidden="true">
        {grid.axis.map((a) => (
          <li class="tt__axis-time" style={`grid-row: ${a.row}`}>
            {fmtTime(a.time)}
          </li>
        ))}
      </ol>
      {tracks.map((track, col) => (
        <section class="tt__track" style={`--col: ${col + 2}`}>
          <h2 class="tt__track-title">{track.name}</h2>
          <ol class="tt__list">
            {track.items.map((i) => (
              <li
                class:list={['tt__item', `tt__item--${i.type}`, { 'tt__item--dummy': i.dummy }]}
                style={`grid-row: ${grid.rowOf(i)}`}
              >
                <p class="tt__time">
                  <time datetime={i.starts_at}>{fmtTime(i.starts_at)}</time>
                  <span aria-hidden="true">–</span>
                  <time datetime={i.ends_at}>{fmtTime(i.ends_at)}</time>
                </p>
                <h3 class="tt__title">
                  {i.url ? (
                    <a href={i.url} target="_blank" rel="noopener noreferrer">
                      {i.title}
                    </a>
                  ) : (
                    i.title
                  )}
                </h3>
                {i.speaker && (
                  <p class="tt__speaker">
                    {i.speaker.avatar_url ? (
                      <img src={i.speaker.avatar_url} alt="" width="28" height="28" loading="lazy" />
                    ) : (
                      <span class="tt__avatar" aria-hidden="true" />
                    )}
                    <span class="tt__speaker-name">{i.speaker.name}</span>
                    {i.speaker.twitter && (
                      <a href={`https://x.com/${i.speaker.twitter}`} target="_blank" rel="noopener noreferrer">
                        @{i.speaker.twitter}
                      </a>
                    )}
                  </p>
                )}
                {i.tags && i.tags.length > 0 && (
                  <ul class="tt__tags">
                    {i.tags.map((t) => (
                      <li style={`color:${t.color_text ?? '#fff'};background:${t.color_background ?? 'var(--c-purple)'}`}>
                        {t.name}
                      </li>
                    ))}
                  </ul>
                )}
                {i.abstract && (
                  <details class="tt__abstract">
                    <summary>概要</summary>
                    <p>{i.abstract}</p>
                  </details>
                )}
              </li>
            ))}
          </ol>
        </section>
      ))}
    </div>
  )
}

<style>
  .tt__empty {
    text-align: center;
    padding: 40px 0;
    color: var(--c-text-muted);
    display: flex;
    flex-direction: column;
    gap: 24px;
    align-items: center;
  }

  .tt__arrow {
    display: inline-flex;
    width: 20px;
    height: 20px;
  }

  /*
   * PC: 1つのグリッド。1列目が時刻の軸、2列目以降がトラック。
   * 行は開始・終了時刻の境界（lib/timetable.ts の buildTimeGrid）。各枠は inline style の grid-row で開始行〜終了行に置く。
   * section / ol は display: contents で中身を直接グリッドに参加させる。
   */
  .tt {
    display: grid;
    grid-template-columns: auto repeat(var(--tracks, 1), minmax(0, 1fr));
    column-gap: 16px;
    row-gap: 8px;
    align-items: stretch;
  }

  .tt__track,
  .tt__list,
  .tt__axis {
    display: contents;
  }

  .tt__track-title {
    grid-row: 1;
    grid-column: var(--col);
    margin-bottom: 4px;
  }

  .tt__item {
    grid-column: var(--col);
  }

  /* 時刻の軸（何かが始まる時刻だけ出す） */
  .tt__axis-time {
    grid-column: 1;
    align-self: start;
    padding-top: 14px;
    font-weight: 700;
    font-size: 12px;
    line-height: 1;
    color: var(--c-text-muted);
    white-space: nowrap;
    font-variant-numeric: tabular-nums;
  }

  .tt__track-title {
    font-family: var(--font-head);
    font-weight: 800;
    font-size: 18px;
    letter-spacing: 0.04em;
    text-align: center;
    color: var(--c-white);
    background: var(--c-purple);
    border-radius: var(--radius-sm);
    padding: 10px 12px;
  }

  .tt__item {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 14px 16px;
    border-radius: var(--radius-sm);
    background: var(--c-bg-lavender);
    border: 1px solid var(--c-line);
  }

  /* 休憩・オープニングなどの枠は控えめに */
  .tt__item--timeslot {
    background: transparent;
    border-style: dashed;
    color: var(--c-text-muted);
    padding-block: 10px;
  }

  .tt__item--timeslot .tt__title {
    font-size: 14px;
    font-weight: 700;
  }

  .tt__time {
    display: flex;
    gap: 4px;
    font-weight: 700;
    font-size: 13px;
    color: var(--c-purple-dark);
    white-space: nowrap;
  }

  .tt__title {
    font-weight: 700;
    font-size: 15px;
    line-height: 1.6;
  }

  .tt__title a {
    color: var(--c-text);
    text-decoration-color: var(--c-pink);
  }

  .tt__speaker {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 8px;
    font-size: 13px;
    color: var(--c-text-muted);
  }

  .tt__speaker img,
  .tt__avatar {
    width: 28px;
    height: 28px;
    border-radius: 50%;
    object-fit: cover;
    background: var(--c-placeholder);
    flex-shrink: 0;
  }

  .tt__speaker a {
    color: var(--c-purple);
    font-size: 12px;
  }

  .tt__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 6px;
  }

  .tt__tags li {
    font-size: 11px;
    font-weight: 700;
    padding: 2px 10px;
    border-radius: 999px;
  }

  .tt__abstract {
    font-size: 13px;
    line-height: 1.8;
  }

  .tt__abstract summary {
    cursor: pointer;
    font-weight: 700;
    color: var(--c-purple);
    list-style: none;
  }

  .tt__abstract summary::-webkit-details-marker {
    display: none;
  }

  .tt__abstract summary::before {
    content: '▸ ';
  }

  .tt__abstract[open] summary::before {
    content: '▾ ';
  }

  .tt__abstract p {
    margin-top: 4px;
    white-space: pre-line;
    color: var(--c-text);
  }

  /* 開発時のダミー（グレー表示） */
  .tt__item--dummy {
    background: #f1eff4;
    border-color: #ddd;
  }

  .tt__item--dummy .tt__title,
  .tt__item--dummy .tt__speaker,
  .tt__item--dummy .tt__abstract p {
    color: #999;
  }

  /* スマホ: グリッドをやめてトラックごとに縦に積む（inline の grid-row は親がグリッドでないので効かない） */
  @media (max-width: 860px) {
    .tt {
      display: flex;
      flex-direction: column;
      gap: 32px;
    }

    .tt__axis {
      display: none;
    }

    .tt__track {
      display: block;
    }

    .tt__track-title {
      margin-bottom: 12px;
    }

    .tt__list {
      display: grid;
      gap: 10px;
    }
  }
</style>
