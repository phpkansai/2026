---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../lib/data';
import { slot } from '../lib/slots';

interface Props {
  title?: string;
  description?: string;
  /** トップページ以外は true（ナビのアンカーが /#xxx になる） */
  subpage?: boolean;
}

const { title, description = site.event.description, subpage = false } = Astro.props;
const pageTitle = title ? `${title} | ${site.event.name}` : site.event.name;

const base = site.url?.replace(/\/$/, '') ?? '';
const canonical = base ? `${base}${Astro.url.pathname}` : undefined;
const ogp = slot('ogp');
const ogImage = ogp && base ? `${base}${ogp}` : undefined;
const favicon = slot('favicon') ?? '/favicon-32.png';
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={favicon} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.event.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@700;800&family=Noto+Sans+JP:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <Header subpage={subpage} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
