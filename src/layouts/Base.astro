---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { site } from '../lib/data';
import { slot } from '../lib/slots';

interface Props {
  title?: string;
  description?: string;
  /** トップページ以外は true（ナビのアンカーが /#xxx になる） */
  subpage?: boolean;
}

const { title, description = site.event.description, subpage = false } = Astro.props;
const pageTitle = title ? `${title} | ${site.event.name}` : site.event.name;

const base = site.url?.replace(/\/$/, '') ?? '';
const canonical = base ? `${base}${Astro.url.pathname}` : undefined;
const ogp = slot('ogp');
const ogImage = ogp && base ? `${base}${ogp}` : undefined;
const favicon = slot('favicon') ?? '/favicon-32.png';
// アクセス解析: IDが設定されていて、かつ本番ビルドのときだけタグを出す（開発中の閲覧を計測しない）
// GTM（GTM-XXXXXXX）を優先。GA4 の測定ID（G-XXXXXXXXXX）は GTM を使わない場合の直接埋め込み用。
const gtmId = site.analytics?.gtm_container_id?.trim() || '';
const gaId = site.analytics?.ga_measurement_id?.trim() || '';
const gtmEnabled = Boolean(gtmId) && import.meta.env.PROD;
const gaEnabled = Boolean(gaId) && import.meta.env.PROD;
---

<!doctype html>
<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    <link rel="icon" href={favicon} />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.event.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content={ogImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={description} />
    {ogImage && <meta name="twitter:image" content={ogImage} />}
    {
      gtmEnabled && (
        <script is:inline define:vars={{ gtmId }}>
          (function (w, d, s, l, i) {
            w[l] = w[l] || [];
            w[l].push({ 'gtm.start': new Date().getTime(), event: 'gtm.js' });
            var f = d.getElementsByTagName(s)[0],
              j = d.createElement(s),
              dl = l != 'dataLayer' ? '&l=' + l : '';
            j.async = true;
            j.src = 'https://www.googletagmanager.com/gtm.js?id=' + i + dl;
            f.parentNode.insertBefore(j, f);
          })(window, document, 'script', 'dataLayer', gtmId);
        </script>
      )
    }
    {
      gaEnabled && (
        <>
          <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`}></script>
          <script is:inline define:vars={{ gaId }}>
            window.dataLayer = window.dataLayer || [];
            function gtag() {
              dataLayer.push(arguments);
            }
            gtag('js', new Date());
            gtag('config', gaId);
          </script>
        </>
      )
    }
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=M+PLUS+Rounded+1c:wght@700;800&family=Noto+Sans+JP:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    {
      gtmEnabled && (
        <noscript>
          <iframe
            src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
            height="0"
            width="0"
            style="display:none;visibility:hidden"
          />
        </noscript>
      )
    }
    <Header subpage={subpage} />
    <main>
      <slot />
    </main>
    <Footer />
  </body>
</html>
