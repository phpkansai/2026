---
/**
 * PHPerシールの説明ページ（/phper-sticker/）。トップのチケットセクションから別タブで開く。
 * 初参加の人が「シールとは何か」「自分の画像・名前がどう使われるか」「いつまでに何をするか」を迷わず分かることを最優先に構成。
 * 期限・フォームURL・チケット名は site.yaml の tickets から参照する。
 * 画像は src/assets/phper-sticker/ に決まった名前で置くと表示される（同フォルダの README 参照）。
 */
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import ArrowOutwardIcon from '../components/icons/ArrowOutwardIcon.astro';
import { site } from '../lib/data';
import { phperStickerImages } from '../lib/assets';

const { tickets, event, links } = site;
const { phper_sticker: sticker, invite } = tickets;
const deadline = sticker.deadline_label;
const formUrl = sticker.form_url?.trim() ?? '';
const hasForm = formUrl.length > 0;
// 開発サーバーでは、画像がまだ無い場所にグレーの枠を出してファイル名を知らせる
const showPlaceholder = import.meta.env.DEV;

/** src/assets/phper-sticker/ から拡張子違いを含めて探す */
function findImage(base: string) {
  for (const ext of ['png', 'jpg', 'jpeg', 'webp', 'svg', 'gif']) {
    const img = phperStickerImages.get(`${base}.${ext}`);
    if (img) return img;
  }
  return undefined;
}

/** 去年（2025年）のシール例。画像・XのID・シール表示名・チケット番号が載る */
const examples = [1, 2, 3].map((n) => ({
  file: `example-${n}`,
  image: findImage(`example-${n}`),
  alt: `PHPカンファレンス関西2025のPHPerシールの例${n}。中央に丸く切り抜かれた画像、その下にXのIDとシール表示名、右下にチケット番号が印刷されている`,
}));
const hasExamples = examples.some((e) => e.image);

const figures = {
  ticketNumber: {
    file: 'ticket-number',
    image: findImage('ticket-number'),
    alt: 'Peatixアプリのチケット画面。「1 x 【一般入場】お誘いチケット」の右側の「#1」が赤枠で囲まれている。その下に「1 x 懇親会チケット #1」の行もあり、開催日時の右側の参加者名は黒塗りになっている',
    caption: '赤枠の「#1」がチケット番号、黒塗りの部分が参加者名です。画面はお誘いチケットを1枚譲渡し終えた後の例ですが、通常チケットでも同じ位置に表示されます。',
  },
  ng1: {
    file: 'ng-1',
    image: findImage('ng-1'),
    alt: 'お誘いチケットが「2 x」と表示され、「#1 #2」が一緒に表示されている Peatix の画面',
    caption: 'NG例1：まだ譲渡していない状態。2枚分が1行にまとまって「2 x」「#1 #2」と表示されています。',
  },
  ng2: {
    file: 'ng-2',
    image: findImage('ng-2'),
    alt: 'お誘いチケットの「#1」と「#2」が別の行に表示されている Peatix の画面',
    caption: 'NG例2：譲渡用URLを送ったが、相手がまだ受け取っていない状態。「#1」と「#2」が別の行に分かれて表示されています。',
  },
};

/** 投稿した画像・名前がどう使われるか。フォームを開く前に理解してもらうためのもの */
const usageNotes = [
  '投稿した画像と名前は、あなたに渡すシールの印刷にだけ使います。Webサイトや公式SNSには掲載しません。',
  'シールは交換した相手の手元に残ります。「他の人に渡っても気にならない画像」と「会場で呼ばれたい名前」を選んでください。',
  'X（旧Twitter）のIDは任意です。知られたくなければ空欄で大丈夫です。',
  '他人の写真やイラストなど、ご自身に使う権利のない画像は投稿しないでください。',
  'シールを交換するかどうかは、当日ご自身で決めて大丈夫です。',
];

/** フォームの入力項目。シールに載るかどうかを明示する */
const formItems = [
  { name: 'シール用の画像', printed: true, note: '丸く切り抜かれます。正方形がおすすめ' },
  { name: 'シール表示名', printed: true, note: '会場で呼ばれたい名前。SNSと違ってOK' },
  { name: 'X（旧Twitter）のID', printed: true, note: '任意。空欄なら載りません' },
  { name: 'チケット番号', printed: true, note: '配布時の照合のためシールにも載ります。確認方法は下にあります' },
  { name: 'Peatix上の参加者名', printed: false, note: 'チケットとの照合用。確認方法は下にあります' },
  { name: 'メールアドレス', printed: false, note: '運営から連絡が必要なときに使います' },
];

const peatixHelp = {
  check: {
    label: 'チケットの確認方法（Peatix ヘルプ）',
    url: 'https://help-attendee.peatix.com/ja-JP/support/solutions/folders/44001195618',
  },
  transfer: {
    label: 'チケットを譲渡する（Peatix ヘルプ）',
    url: 'https://help-attendee.peatix.com/ja-JP/support/solutions/articles/44001821789',
  },
  receive: {
    label: '譲渡されたチケットを受け取る（Peatix ヘルプ）',
    url: 'https://help-attendee.peatix.com/ja-JP/support/solutions/articles/44001821790',
  },
};
---

<Base
  title="PHPerシールについて"
  subpage
  description={`${event.name}では今年もPHPerシールを配布します。希望される方は${deadline}までにチケットの購入と画像投稿フォームへの投稿をお願いします。`}
>
  <section class="section section--pink">
    <div class="container--narrow">
      <div class="card">
        <h1 class="section-title section-title--purple">PHPerシールについて</h1>

        <div class="prose sticker">
          <p class="sticker__lead">
            {event.name}では、今年も<strong>PHPerシール</strong>を配布します！<br />
            希望する方は<strong>{deadline}まで</strong>に、チケットの購入と画像投稿フォームへの投稿をお願いします。
          </p>
          {
            hasForm && (
              <div class="sticker__cta sticker__cta--top">
                <a class="btn btn--lg" href={formUrl} target="_blank" rel="noopener noreferrer">
                  {sticker.form_button}
                  <span class="sticker__arrow">
                    <ArrowOutwardIcon />
                  </span>
                </a>
                <p class="sticker__cta-note">投稿に必要なチケット番号の確認方法など、詳しい説明はこの下にあります。</p>
              </div>
            )
          }

          <h2>PHPerシールとは</h2>
          <p>
            PHPerシールは、参加者のアイコン画像や表示名を使って作るシールです。参加者同士で交換して、自己紹介や会話のきっかけにしましょう！また、PHPerシールにはX（旧Twitter）のアカウントが記載されているため、カンファレンスが終わった後も繋がった人と情報交換をしましょう！
          </p>
          {
            (hasExamples || showPlaceholder) && (
              <figure class="sticker__examples">
                <div class="sticker__examples-grid">
                  {examples.map((e) =>
                    e.image ? (
                      <Image src={e.image} alt={e.alt} widths={[300, 600]} sizes="(max-width: 600px) 45vw, 200px" />
                    ) : (
                      showPlaceholder && (
                        <div class="sticker__placeholder sticker__placeholder--square">
                          src/assets/phper-sticker/{e.file}.png
                        </div>
                      )
                    ),
                  )}
                </div>
                <figcaption>去年（2025年）のシールの例。中央に投稿した画像、その下にXのID（任意）とシール表示名、右下にチケット番号が載ります。</figcaption>
              </figure>
            )
          }

          <h2>投稿した画像と名前について</h2>
          <ul class="sticker__usage">
            {usageNotes.map((n) => <li>{n}</li>)}
          </ul>

          <h2>申し込みの流れと締切</h2>
          <p>
            <strong>{deadline}まで</strong>に、次の手続きをすべて済ませてください。
          </p>
          <ol class="sticker__steps">
            <li>Peatixでチケットを購入する（譲ってもらう方は、Peatixで受け取り手続きを済ませる）</li>
            <li>
              お誘いチケットを買った方は、相手の受け取りまで完了する（手順は<a href="#invite">お誘いチケットを買った人・譲ってもらった人へ</a>）<br />
              <span class="sticker__sub">
                お誘いチケットは、{invite.min_quantity}枚以上まとめて買って一緒に来る人に譲るチケットです（<a href={invite.page}
                  >{invite.link_label}</a
                >）。通常チケットを1枚買った方はこの手順は不要です。
              </span>
            </li>
            <li>
              画像と必要事項を画像投稿フォームから投稿する（フォームは<a href="#form">ページ最下部</a>{hasForm ? 'のボタンから' : 'に公開予定'}）
            </li>
          </ol>
          <p class="sticker__note">
            チケットを購入しただけでは、PHPerシールの申し込みは完了しません。<strong>必ずフォームへの投稿</strong>もお願いします。
          </p>

          <h2>フォームで入力するもの</h2>
          <div class="sticker__table-wrap">
            <table class="sticker__table">
              <thead>
                <tr>
                  <th>項目</th>
                  <th>シールに載る？</th>
                  <th>補足</th>
                </tr>
              </thead>
              <tbody>
                {
                  formItems.map((item) => (
                    <tr>
                      <td>{item.name}</td>
                      <td class={item.printed ? 'sticker__printed' : 'sticker__not-printed'}>
                        {item.printed ? '載る' : '載らない'}
                      </td>
                      <td>{item.note}</td>
                    </tr>
                  ))
                }
              </tbody>
            </table>
          </div>

          <h2 id="ticket-number">チケット番号と参加者名の確認方法</h2>
          <p>
            Peatixにログインし、{event.name}のチケット画面を開いてください。譲ってもらった方は、受け取ったアカウントでログインしてください。
          </p>
          <ul>
            <li>
              <strong>チケット番号</strong>：「【一般入場】」と書かれた行の右端にある番号です。「#」を除いた数字を入力してください（例：「#1」→「1」）。懇親会チケットの番号ではありません。
            </li>
            <li>
              <strong>参加者名</strong>：チケット画面に表示されている名前をそのまま入力してください。アプリ版では開催日時の右側、ブラウザ版ではQRコードの下にあります。
            </li>
          </ul>
          {
            (figures.ticketNumber.image || showPlaceholder) && (
              <figure class="sticker__figure sticker__figure--portrait">
                {figures.ticketNumber.image ? (
                  <Image
                    src={figures.ticketNumber.image}
                    alt={figures.ticketNumber.alt}
                    widths={[400, 800]}
                    sizes="(max-width: 600px) 90vw, 360px"
                  />
                ) : (
                  <div class="sticker__placeholder">src/assets/phper-sticker/{figures.ticketNumber.file}.png</div>
                )}
                <figcaption>{figures.ticketNumber.caption}</figcaption>
              </figure>
            )
          }
          <p class="sticker__help-link">
            <a href={peatixHelp.check.url} target="_blank" rel="noopener noreferrer">{peatixHelp.check.label}</a>
          </p>

          <h2 id="invite">お誘いチケットを買った人・譲ってもらった人へ</h2>
          <h3>買った人</h3>
          <ul>
            <li>自分の分を残し、一緒に来る人の分をPeatixで譲渡してください。</li>
            <li>
              <strong>譲渡用のURLを送っただけでは完了しません。</strong>相手がPeatixで受け取り手続きを終える必要があります。
            </li>
            <li>
              相手の受け取りが完了してから、自分のチケット番号でフォームに投稿してください。譲渡が終わるまでは、どの番号があなたのチケットになるか確定しないためです。
            </li>
            <li>相手にも、このページと{deadline}の締切を伝えてください。</li>
          </ul>
          <h3>譲渡が終わったかどうかはこの表示で確認</h3>
          <p>
            譲渡が完了すると、買った人のチケット画面にはお誘いチケットが<strong>「1 x」の1行だけ</strong>残ります。<a href="#ticket-number">チケット番号と参加者名の確認方法</a>にある画面例が、この完了後の状態です。次のように表示されているうちは、まだ投稿しないでください。
          </p>
          {
            [figures.ng1, figures.ng2].map(
              (f) =>
                (f.image || showPlaceholder) && (
                  <figure class="sticker__figure">
                    {f.image ? (
                      <Image src={f.image} alt={f.alt} widths={[400, 800]} sizes="(max-width: 600px) 90vw, 640px" />
                    ) : (
                      <div class="sticker__placeholder sticker__placeholder--wide">src/assets/phper-sticker/{f.file}.png</div>
                    )}
                    <figcaption>{f.caption}</figcaption>
                  </figure>
                ),
            )
          }
          <p class="sticker__help-link">
            <a href={peatixHelp.transfer.url} target="_blank" rel="noopener noreferrer">{peatixHelp.transfer.label}</a>
          </p>

          <h3>譲ってもらった人</h3>
          <ul>
            <li>Peatixで受け取り手続きをしてください。</li>
            <li>シールが欲しい場合は、自分のアカウントでチケット番号と参加者名を確認して、フォームに投稿してください。</li>
          </ul>

          <p class="sticker__help-link">
            <a href={peatixHelp.receive.url} target="_blank" rel="noopener noreferrer">{peatixHelp.receive.label}</a>
          </p>
        </div>

        <div class="sticker__cta" id="form">
          {
            hasForm ? (
              <a class="btn btn--lg" href={formUrl} target="_blank" rel="noopener noreferrer">
                {sticker.form_button}
                <span class="sticker__arrow">
                  <ArrowOutwardIcon />
                </span>
              </a>
            ) : (
              <p class="sticker__form-pending">
                画像投稿フォームは準備中です。公開したらこのページと<a href={links.x} target="_blank" rel="noopener noreferrer">公式X</a>でお知らせします。
              </p>
            )
          }
          <p class="sticker__cta-note">会場でシールを交換しながら、交流を楽しみましょう！</p>
        </div>

        <p class="back"><a href="/#tickets">トップページへ戻る</a></p>
      </div>
    </div>
  </section>
</Base>

<style>
  .sticker__lead {
    margin-top: 32px;
    font-size: 16px;
    line-height: 2;
  }

  .sticker strong {
    color: var(--c-pink-dark);
  }

  /* 画像・名前の使われ方の注意点 */
  .sticker__usage {
    padding: 16px 20px 16px 2.4em;
    background: var(--c-bg-pink);
    border-radius: var(--radius-sm);
    margin-bottom: 1em;
  }

  .sticker__usage li {
    margin-bottom: 0.5em;
    line-height: 1.8;
  }

  .sticker__usage li:last-child {
    margin-bottom: 0;
  }

  .sticker__steps {
    list-style: decimal;
    padding-left: 1.6em;
    margin-bottom: 1em;
  }

  .sticker__steps li {
    margin-bottom: 0.5em;
  }

  /* 手順の下に添える補足（お誘いチケットの一言説明） */
  .sticker__sub {
    display: block;
    font-size: 13px;
    line-height: 1.8;
    color: var(--c-text-muted);
    margin-top: 2px;
  }

  /* 「チケットを買っただけでは完了しない」の注意書き */
  .sticker__note {
    padding: 14px 18px;
    background: var(--c-bg-pink);
    border-left: 4px solid var(--c-pink);
    border-radius: var(--radius-sm);
    font-weight: 700;
  }

  /* フォーム入力項目の表 */
  .sticker__table-wrap {
    overflow-x: auto;
    margin-bottom: 1em;
  }

  .sticker__table {
    width: 100%;
    min-width: 480px;
    border-collapse: collapse;
    font-size: 14px;
    line-height: 1.7;
  }

  .sticker__table th,
  .sticker__table td {
    padding: 8px 10px;
    border-bottom: 1px solid var(--c-line);
    text-align: left;
    vertical-align: top;
  }

  .sticker__table th {
    background: var(--c-bg-pink);
    font-weight: 700;
    white-space: nowrap;
  }

  .sticker__table td:first-child {
    white-space: nowrap;
    font-weight: 700;
  }

  .sticker__printed {
    color: var(--c-pink-dark);
    font-weight: 700;
    white-space: nowrap;
  }

  .sticker__not-printed {
    color: var(--c-text-muted);
    white-space: nowrap;
  }

  /* スマホ幅では表を縦積みにする（項目名＋載る/載らない を1行、補足をその下） */
  @media (max-width: 600px) {
    .sticker__table {
      min-width: 0;
    }

    .sticker__table thead {
      display: none;
    }

    .sticker__table tr {
      display: grid;
      grid-template-columns: 1fr auto;
      column-gap: 12px;
      padding: 10px 0;
      border-bottom: 1px solid var(--c-line);
    }

    .sticker__table td {
      display: block;
      padding: 0;
      border: 0;
      white-space: normal;
    }

    .sticker__table td:nth-child(3) {
      grid-column: 1 / -1;
      margin-top: 2px;
      font-size: 13px;
      color: var(--c-text-muted);
    }
  }

  /* 去年のシール例（3枚並び） */
  .sticker__examples {
    margin: 20px auto 24px;
    max-width: 640px;
  }

  .sticker__examples-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 12px;
  }

  .sticker__examples-grid img,
  .sticker__examples-grid .sticker__placeholder {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius-sm);
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.12);
  }

  .sticker__examples figcaption {
    margin-top: 8px;
    font-size: 13px;
    line-height: 1.7;
    color: var(--c-text-muted);
    text-align: center;
  }

  .sticker__placeholder--square {
    aspect-ratio: 1 / 1;
  }

  .sticker__figure {
    margin: 20px auto 24px;
    max-width: 640px;
  }

  .sticker__figure--portrait {
    max-width: 360px;
  }

  .sticker__figure img {
    display: block;
    width: 100%;
    height: auto;
    border: 1px solid var(--c-line);
    border-radius: var(--radius-sm);
  }

  .sticker__figure figcaption {
    margin-top: 8px;
    font-size: 13px;
    line-height: 1.7;
    color: var(--c-text-muted);
    text-align: center;
  }

  /* 開発サーバーで画像が無いときの仮枠 */
  .sticker__placeholder {
    display: grid;
    place-items: center;
    aspect-ratio: 605 / 800;
    background: var(--c-placeholder);
    border-radius: var(--radius-sm);
    font-size: 12px;
    color: var(--c-white);
    word-break: break-all;
    padding: 12px;
    text-align: center;
  }

  .sticker__placeholder--wide {
    aspect-ratio: 800 / 180;
  }

  /* 各セクション末尾のPeatixヘルプへのリンク */
  .sticker__help-link {
    font-size: 13px;
  }

  .sticker__help-sep {
    color: var(--c-text-muted);
    margin: 0 4px;
  }

  .sticker__cta {
    margin-top: 40px;
    text-align: center;
  }

  /* リード直下のボタン（説明を読まずに投稿したい人向け）。.prose 内なので .prose a の文字色に負けないよう白を指定し直す */
  .sticker__cta--top {
    margin: 24px 0 8px;
  }

  .sticker__cta--top .btn {
    color: var(--c-white);
  }

  .sticker__cta--top .sticker__cta-note {
    margin-top: 10px;
    font-size: 13px;
    color: var(--c-text-muted);
  }

  .sticker__cta-note {
    margin-top: 16px;
    font-size: 14px;
  }

  .sticker__form-pending {
    display: inline-block;
    padding: 10px 24px;
    border: 2px dashed var(--c-line);
    border-radius: 999px;
    font-size: 14px;
    color: var(--c-text-muted);
    margin-bottom: 0;
  }

  .sticker__arrow {
    display: inline-flex;
    width: 22px;
    height: 22px;
  }

  .back {
    margin-top: 32px;
    text-align: center;
    font-size: 14px;
  }
  .back a {
    color: var(--c-purple);
  }
</style>
